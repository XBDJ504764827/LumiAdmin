# ╔══════════════════════════════════════════════════════════╗
# ║  ⚠️  安全警告：生产环境部署前务必修改以下凭证！            ║
# ║  DEV_PASSWORD 默认值为 "change-me"，使用默认密码启动时     ║
# ║  后端会在启动日志中输出醒目的安全告警。                      ║
# ╚══════════════════════════════════════════════════════════╝
DATABASE_URL=postgres://user:pass@localhost:5432/manger
APP_ENV=development
BIND_ADDR=0.0.0.0:3001
DEV_USERNAME=dev
DEV_PASSWORD=change-me

# Steam 中转（Cloudflare Worker）：服务器无法直连 Steam 网络时配置。
# 配置后 Steam 登录、资料/等级查询、自定义 URL 解析全部经中转 Worker 转发；
# 留空则走直连（本地开发/能直连 Steam 的服务器）。
# 与 LumiForum 共用: https://cngokz-steam-auth.iquankz.cn
STEAM_RELAY_URL=
HTTP_TIMEOUT_SECS=300
REQUEST_TIMEOUT_SECS=300
RCON_CONNECT_TIMEOUT_SECS=10
RCON_IO_TIMEOUT_SECS=10

# 全球封禁同步间隔（秒，默认 300 = 5 分钟）
GLOBAL_BAN_SYNC_INTERVAL_SECS=300

# KZTimer 全球封禁分页安全上限（默认 1000 页，每页 500 条）
GLOBAL_BAN_SYNC_MAX_PAGES=1000

# Request body limit should be higher than the largest appeal file because
# multipart uploads include small boundary/header overhead.
APPEAL_FILE_MAX_SIZE_MB=100
MAX_REQUEST_BODY_BYTES=115343360

# Production: use the private Worker gateway on the custom domain.
# R2_WORKER_API_KEY must equal the Worker's API_KEY secret.
# R2_WORKER_SIGNING_KEY must equal the Worker's DOWNLOAD_SIGNING_KEY secret.
R2_WORKER_URL=https://cngokz.iquankz.cn
R2_WORKER_API_KEY=replace-with-strong-upload-key
R2_WORKER_SIGNING_KEY=replace-with-a-different-strong-signing-key

# Optional legacy/development S3 mode. Leave empty when Worker mode is enabled.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# QQ 机器人集成令牌
# 配置后，AstrBot QQ 插件可凭此令牌访问 /api/integration/qq/review-stats 只读统计接口。
# 请使用高强度随机字符串，并与 QQ 插件配置中的 token 保持一致。
# 留空则禁用 QQ 集成接口。
# 生成示例：openssl rand -hex 32
QQ_INTEGRATION_TOKEN=

# LumiBot（QQ 机器人事件接收中心）事件上报
# 配置后，新的白名单申请会写入 lumi_bot_event_queue 队列，
# 后台任务每 LUMI_BOT_SYNC_INTERVAL_SECS 秒集中通过
# POST {LUMI_BOT_API_URL}/api/v1/events（X-API-Key 鉴权）上报给 LumiBot，
# 由 LumiBot 再通知 QQ 管理员/用户。
# 留空则禁用（事件不入队、后台任务不启动）。
# LUMI_BOT_API_URL=http://127.0.0.1:8080
# LUMI_BOT_API_KEY=key-admin
# 上报周期（秒，默认 1800 = 30 分钟）
# LUMI_BOT_SYNC_INTERVAL_SECS=1800
# 单条事件最大上报重试次数（默认 5，超过后标记 failed 不再自动重试）
# LUMI_BOT_MAX_ATTEMPTS=5
# 每轮最多上报的事件条数（默认 100）
# LUMI_BOT_BATCH_SIZE=100
